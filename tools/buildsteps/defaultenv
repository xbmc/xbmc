#helper functions

#hash a dir based on the git revision, Configuration, SDK_PATH, NDK_PATH, NDK_VERSION, SDK_VERSION, TOOLCHAIN and XBMC_DEPENDS_ROOT
#param1 path to be hashed
function getBuildHash ()
{
  local checkPath
  checkPath="$1"
  local hashStr
  hashStr="$(git rev-list HEAD --max-count=1  -- $checkPath)"
  hashStr="$hashStr $Configuration $SDK_PATH $NDK_PATH $NDK_VERSION $SDK_VERSION $TOOLCHAIN $XBMC_DEPENDS_ROOT $XCODE_APP"
  echo $hashStr
}

#param1 path to be checked for changes
function pathChanged ()
{
  local ret
  local checkPath
  ret="0"

  checkPath="$1"
  if [ -e $checkPath/$PATH_CHANGE_REV_FILENAME ]
  then
    if [ "$(cat $checkPath/$PATH_CHANGE_REV_FILENAME)" != "$(getBuildHash $checkPath)" ]
    then
      ret="1"
    fi
  else
    ret="1"
  fi

  echo $ret
}

#param1 path to be tagged with hash
function tagSuccessFulBuild ()
{
  local pathToTag
  pathToTag="$1"
  # tag last successful build with revisions of the given dir
  # needs to match the checks in function getBuildHash
  echo "$(getBuildHash $pathToTag)" > $pathToTag/$PATH_CHANGE_REV_FILENAME
}

#param1 path to be tagged with hash
function tagFailedBuild ()
{
  local pathToTag
  pathToTag="$1"
  # tag last failed build with revisions of the given dir
  # needs to match the checks in function getBuildHash
  echo "$(getBuildHash $pathToTag)" > $pathToTag/$FAILED_BUILD_FILENAME
}

#param1 cached path
#param2 build hash of the cached path
function getBuildCacheEntry ()
{
  echo "$BUILD_CACHE_DIR/$(echo "$1 $2" | git hash-object --stdin)"
}

#move the untracked files of a successful build into the build cache
#param1 path to be cached
function cacheBuild ()
{
  local checkPath
  local entry
  local file
  checkPath="$1"
  if [ "$BUILD_CACHE_ENTRIES" -le 0 ]
  then
    rm -rf $BUILD_CACHE_DIR
    return
  fi
  if [ ! -e $checkPath/$PATH_CHANGE_REV_FILENAME ]
  then
    return
  fi

  entry=$(getBuildCacheEntry $checkPath "$(cat $checkPath/$PATH_CHANGE_REV_FILENAME)")
  rm -rf $entry
  mkdir -p $entry/tree
  (cd $checkPath && git ls-files --others --directory -z) > $entry/files
  while IFS= read -r -d '' file
  do
    file=${file%/}
    mkdir -p "$entry/tree/$(dirname "$file")"
    mv "$checkPath/$file" "$entry/tree/$file"
  done < $entry/files

  #the current revision's entry is about to be restored, so it does not count
  entry=$(getBuildCacheEntry $checkPath "$(getBuildHash $checkPath)")
  ls -1td $BUILD_CACHE_DIR/*/ | grep -vF "$entry/" | tail -n +$((BUILD_CACHE_ENTRIES + 1)) | xargs rm -rf
}

#move a cached build of the current revision back into place
#param1 path to be restored
#returns 1 if there is no cached build to restore
function restoreCachedBuild ()
{
  local checkPath
  local entry
  local file
  checkPath="$1"
  entry=$(getBuildCacheEntry $checkPath "$(getBuildHash $checkPath)")
  if [ ! -e $entry/files ]
  then
    return 1
  fi

  while IFS= read -r -d '' file
  do
    file=${file%/}
    if ! mv "$entry/tree/$file" "$checkPath/$file"
    then
      rm -rf $entry
      git clean -xffd $checkPath
      return 1
    fi
  done < $entry/files
  rm -rf $entry
}

#clean the workspace, keeping the depends build if tools/depends has not changed
function prepareDepends ()
{
  #clean without depends for skipping depends build if possible
  #also skip binary addons (pvr, audioencoder) as long as they are deployed in tree
  cd $WORKSPACE;git clean -xfd -e "cmake/.last_success_revision" -e "tools/depends" -e "/$BUILD_CACHE_NAME" ${DEPLOYED_BINARY_ADDONS}

  # if depends path has changed - cleanout everything and restore a cached build of this revision or do a full rebuild
  if [ "$(pathChanged $WORKSPACE/tools/depends)" == "1" ]
  then
    cacheBuild $WORKSPACE/tools/depends
    #clean up the rest too
    cd $WORKSPACE;git clean -xffd -e "/$BUILD_CACHE_NAME"
    if ! restoreCachedBuild $WORKSPACE/tools/depends
    then
      cd $WORKSPACE/tools/depends/;./bootstrap
    fi
  fi
}

