package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Intent;
import android.os.Bundle;

// Home screen entry point, enabled by the "Use as home screen" setting.
// Main can't be the home activity itself: Android would start a second
// instance of it as a home activity next to the running one.
public class Home extends Activity
{
  private static final String ACTION_HOME = "android.intent.XBMC_HOME";

  @Override
  protected void onCreate(Bundle savedInstanceState)
  {
    super.onCreate(savedInstanceState);

    Intent intent;
    if (Main.isActivityRunning())
    {
      intent = new Intent(ACTION_HOME, null, this, Main.class);
      intent.addFlags(Intent.FLAG_ACTIVITY_NO_ANIMATION);
    }
    else
    {
      intent = new Intent(Intent.ACTION_MAIN, null, this, Splash.class);
    }
    startActivity(intent);
    finish();
    overridePendingTransition(0, 0);
  }
}
