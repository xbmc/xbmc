--- a/mariadb_config/CMakeLists.txt
+++ b/mariadb_config/CMakeLists.txt
@@ -25,6 +25,14 @@
   ENDIF()
 ENDFUNCTION()
 
+# Static plugin libraries are only added to SYSTEM_LIBS in the libmariadb/ scope,
+# so add zstd here to get it into libmariadb.pc Libs.private. Pass -L/-l flags,
+# GET_LIB_NAME() would turn the archive path into -l/path/libzstd.a
+IF(ZSTD_FOUND AND CLIENT_PLUGIN_ZSTD STREQUAL "STATIC")
+  GET_FILENAME_COMPONENT(ZSTD_LIBRARY_DIR ${ZSTD_LIBRARIES} DIRECTORY)
+  SET(SYSTEM_LIBS ${SYSTEM_LIBS} -L${ZSTD_LIBRARY_DIR} -lzstd)
+ENDIF()
+
 LIST(LENGTH SYSTEM_LIBS rllength)
 IF(${rllength} GREATER 0)
   LIST(REMOVE_DUPLICATES SYSTEM_LIBS)
