+static int rendition_in_variant(const struct rendition *rend, const struct variant *var)
+{
+    switch (rend->type) {
+    case AVMEDIA_TYPE_AUDIO:    return var->audio_group[0] && !strcmp(rend->group_id, var->audio_group);
+    case AVMEDIA_TYPE_VIDEO:    return var->video_group[0] && !strcmp(rend->group_id, var->video_group);
+    case AVMEDIA_TYPE_SUBTITLE: return var->subtitles_group[0] && !strcmp(rend->group_id, var->subtitles_group);
+    default:                    return 0;
+    }
+}
