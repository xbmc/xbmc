+/*
+ * Keep only the variant with the highest resolution, then bandwidth, not
+ * above max_bandwidth (or the lowest bandwidth one if none fits) and the
+ * playlists it uses, so the other variants are never downloaded.
+ */
+static void select_single_variant(HLSContext *c)
+{
+    struct variant *sel = NULL;
+    int i, n;
+
+    for (i = 0; i < c->n_variants; i++) {
+        struct variant *var = c->variants[i];
+        int fits     = !c->max_bandwidth || var->bandwidth <= c->max_bandwidth;
+        int sel_fits = sel && (!c->max_bandwidth || sel->bandwidth <= c->max_bandwidth);
+
+        if (!sel || (fits && (!sel_fits || var->pixels > sel->pixels ||
+                              (var->pixels == sel->pixels && var->bandwidth > sel->bandwidth))) ||
+            (!fits && !sel_fits && var->bandwidth < sel->bandwidth))
+            sel = var;
+    }
+
+    for (i = 0; i < c->n_variants; i++) {
+        if (c->variants[i] != sel) {
+            av_freep(&c->variants[i]->playlists);
+            av_freep(&c->variants[i]);
+        }
+    }
+    c->variants[0] = sel;
+    c->n_variants  = 1;
+
+    /* needed is still unset here, so use it to mark the playlists to keep. */
+    sel->playlists[0]->needed = 1;
+    for (i = 0; i < c->n_renditions; i++)
+        if (c->renditions[i]->playlist && rendition_in_variant(c->renditions[i], sel))
+            c->renditions[i]->playlist->needed = 1;
+
+    /* Drop the renditions whose playlist is freed below */
+    for (i = 0, n = 0; i < c->n_renditions; i++) {
+        struct rendition *rend = c->renditions[i];
+
+        if (!rend->playlist || rend->playlist->needed)
+            c->renditions[n++] = rend;
+        else
+            av_free(rend);
+    }
+    c->n_renditions = n;
+
+    for (i = 0, n = 0; i < c->n_playlists; i++) {
+        struct playlist *pls = c->playlists[i];
+
+        if (pls->needed) {
+            pls->needed = 0;
+            c->playlists[n++] = pls;
+        } else {
+            free_playlist(c, pls);
+        }
+    }
+    c->n_playlists = n;
+}
