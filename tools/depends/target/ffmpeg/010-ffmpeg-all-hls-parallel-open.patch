+/* Protects state shared between playlists opened in parallel */
+static void hls_lock(HLSContext *c)
+{
+    if (c->in_parallel)
+        ff_mutex_lock(&c->lock);
+}
+
+static void hls_unlock(HLSContext *c)
+{
+    if (c->in_parallel)
+        ff_mutex_unlock(&c->lock);
+}
+
+static int has_line(const char *str, const char *line, size_t len)
+{
+    while (*str) {
+        size_t n = strcspn(str, "\n");
+        if (n == len && !memcmp(str, line, len))
+            return 1;
+        str += n + (str[n] == '\n');
+    }
+    return 0;
+}
+
+/* Parallel requests all start from the same cookie jar, so add the cookies
+ * a response set to the current jar instead of replacing it. */
+static char *merge_cookies(const char *jar, const char *cookies)
+{
+    AVBPrint bp;
+    char *ret;
+
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "%s", jar);
+    while (*cookies) {
+        size_t n = strcspn(cookies, "\n");
+        if (n && !has_line(jar, cookies, n)) {
+            if (bp.len && bp.str[bp.len - 1] != '\n')
+                av_bprint_chars(&bp, '\n', 1);
+            av_bprint_append_data(&bp, cookies, n);
+            av_bprint_chars(&bp, '\n', 1);
+        }
+        cookies += n + (cookies[n] == '\n');
+    }
+    if (av_bprint_finalize(&bp, &ret) < 0)
+        return NULL;
+    return ret;
+}
