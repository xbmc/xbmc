+/* Copy the options for a request, keeping the cookies it is sent with for
+ * merge_cookies(). */
+static int copy_request_opts(HLSContext *c, AVDictionary **tmp, AVDictionary *opts,
+                             AVDictionary *opts2, char **sent)
+{
+    const AVDictionaryEntry *e;
+    int ret;
+
+    av_freep(sent);
+    hls_lock(c);
+    ret = av_dict_copy(tmp, opts, 0);
+    if (ret >= 0 && c->in_parallel && (e = av_dict_get(opts, "cookies", NULL, 0)) &&
+        !(*sent = av_strdup(e->value)))
+        ret = AVERROR(ENOMEM);
+    hls_unlock(c);
+    if (ret >= 0)
+        ret = av_dict_copy(tmp, opts2, 0);
+    return ret;
+}
