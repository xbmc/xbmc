+typedef int (*playlist_job_func)(AVFormatContext *s, struct playlist *pls, int64_t arg);
+
+#if HAVE_THREADS
+struct playlist_job {
+    AVFormatContext *s;
+    struct playlist *pls;
+    playlist_job_func func;
+    int64_t arg;
+    pthread_t thread;
+    int started;
+    int ret;
+};
+
+static void *playlist_job_thread(void *opaque)
+{
+    struct playlist_job *job = opaque;
+    job->ret = job->func(job->s, job->pls, job->arg);
+    return NULL;
+}
+#endif
+
+/*
+ * Run func on every playlist and store the results in rets. When
+ * c->in_parallel is set, up to c->parallel_open playlists are run at once,
+ * each in its own thread.
+ */
+static int run_playlist_jobs(AVFormatContext *s, playlist_job_func func, int64_t arg, int *rets)
+{
+    HLSContext *c = s->priv_data;
+    int i;
+
+#if HAVE_THREADS
+    if (c->in_parallel && c->n_playlists > 1) {
+        int max_jobs = FFMIN(c->parallel_open, c->n_playlists);
+        struct playlist_job *jobs = av_calloc(max_jobs, sizeof(*jobs));
+        if (!jobs)
+            return AVERROR(ENOMEM);
+
+        for (int start = 0; start < c->n_playlists; start += max_jobs) {
+            int n = FFMIN(max_jobs, c->n_playlists - start);
+
+            for (int i = 0; i < n; i++) {
+                struct playlist_job *job = &jobs[i];
+                job->s    = s;
+                job->pls  = c->playlists[start + i];
+                job->func = func;
+                job->arg  = arg;
+                job->started = !pthread_create(&job->thread, NULL, playlist_job_thread, job);
+                if (!job->started)
+                    job->ret = func(s, job->pls, arg);
+            }
+            for (int i = 0; i < n; i++) {
+                if (jobs[i].started)
+                    pthread_join(jobs[i].thread, NULL);
+                rets[start + i] = jobs[i].ret;
+            }
+        }
+        av_free(jobs);
+        return 0;
+    }
+#endif
+
+    for (i = 0; i < c->n_playlists; i++)
+        rets[i] = func(s, c->playlists[i], arg);
+    return 0;
+}
+
+static int parse_media_playlist(AVFormatContext *s, struct playlist *pls, int64_t unused)
+{
+    HLSContext *c = s->priv_data;
+    int ret;
+
+    pls->m3u8_hold_counters = 0;
+    ret = parse_playlist(c, pls->url, pls, NULL);
+    /* Retry once, a transient error would otherwise drop the playlist */
+    if (ret < 0 && ret != AVERROR_EXIT && !ff_check_interrupt(c->interrupt_callback))
+        ret = parse_playlist(c, pls->url, pls, NULL);
+    return ret;
+}
