+typedef int (*playlist_job_func)(AVFormatContext *s, struct playlist *pls, int64_t arg);
+
+#if HAVE_THREADS
+struct playlist_jobs {
+    AVFormatContext *s;
+    playlist_job_func func;
+    int64_t arg;
+    int *rets;
+    int next;
+};
+
+static void *playlist_job_thread(void *opaque)
+{
+    struct playlist_jobs *jobs = opaque;
+    HLSContext *c = jobs->s->priv_data;
+
+    for (;;) {
+        int i;
+
+        hls_lock(c);
+        i = jobs->next;
+        if (i < c->n_playlists)
+            jobs->next++;
+        hls_unlock(c);
+        if (i == c->n_playlists)
+            return NULL;
+
+        jobs->rets[i] = jobs->func(jobs->s, c->playlists[i], jobs->arg);
+    }
+}
+#endif
+
+/*
+ * Run func on every playlist and store the results in rets. When
+ * c->in_parallel is set, up to c->parallel_open playlists are run at once,
+ * with workers taking the next playlist as soon as one finishes.
+ */
+static int run_playlist_jobs(AVFormatContext *s, playlist_job_func func, int64_t arg, int *rets)
+{
+    HLSContext *c = s->priv_data;
+    int i;
+
+#if HAVE_THREADS
+    if (c->in_parallel && c->n_playlists > 1) {
+        int max_jobs = FFMIN(c->parallel_open, c->n_playlists);
+        struct playlist_jobs jobs = { .s = s, .func = func, .arg = arg, .rets = rets };
+        pthread_t *threads = av_calloc(max_jobs, sizeof(*threads));
+        int started;
+
+        if (!threads)
+            return AVERROR(ENOMEM);
+
+        for (started = 0; started < max_jobs; started++)
+            if (pthread_create(&threads[started], NULL, playlist_job_thread, &jobs))
+                break;
+        if (started < max_jobs)
+            playlist_job_thread(&jobs);
+        for (int i = 0; i < started; i++)
+            pthread_join(threads[i], NULL);
+        av_free(threads);
+        return 0;
+    }
+#endif
+
+    for (i = 0; i < c->n_playlists; i++)
+        rets[i] = func(s, c->playlists[i], arg);
+    return 0;
+}
