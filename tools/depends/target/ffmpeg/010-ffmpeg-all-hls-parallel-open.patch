+/* Protects state shared between playlists opened in parallel */
+static void hls_lock(HLSContext *c)
+{
+    if (c->in_parallel)
+        ff_mutex_lock(&c->lock);
+}
+
+static void hls_unlock(HLSContext *c)
+{
+    if (c->in_parallel)
+        ff_mutex_unlock(&c->lock);
+}
+
+static void trim_span(const char **str, size_t *len)
+{
+    while (*len && strchr(" \t", **str)) {
+        (*str)++;
+        (*len)--;
+    }
+    while (*len && strchr(" \t", (*str)[*len - 1]))
+        (*len)--;
+}
+
+static int span_eq(const char *a, size_t alen, const char *b, size_t blen, int nocase)
+{
+    return alen == blen && !(nocase ? av_strncasecmp(a, b, alen) : memcmp(a, b, alen));
+}
+
+/* Get the value of the attribute key of a Set-Cookie style line, empty if
+ * missing. */
+static void cookie_attr(const char *line, size_t len, const char *key,
+                        const char **val, size_t *vlen)
+{
+    const char *end = line + len, *p = memchr(line, ';', len);
+    size_t klen = strlen(key);
+
+    *val  = "";
+    *vlen = 0;
+    while (p) {
+        const char *attr = p + 1, *q = memchr(attr, ';', end - attr);
+        size_t n = (q ? q : end) - attr;
+
+        trim_span(&attr, &n);
+        if (n > klen && attr[klen] == '=' && !av_strncasecmp(attr, key, klen)) {
+            *val  = attr + klen + 1;
+            *vlen = n - klen - 1;
+            trim_span(val, vlen);
+            return;
+        }
+        p = q;
+    }
+}
+
+static void cookie_name_value(const char *line, size_t len,
+                              const char **name, size_t *nlen,
+                              const char **val, size_t *vlen)
+{
+    const char *eq  = memchr(line, '=', len);
+    const char *end = memchr(line, ';', len);
+
+    if (!end)
+        end = line + len;
+    if (!eq || eq > end)
+        eq = end;
+    *name = line;
+    *nlen = eq - line;
+    *val  = eq < end ? eq + 1 : end;
+    *vlen = end - *val;
+    trim_span(name, nlen);
+    trim_span(val, vlen);
+}
+
+static void cookie_domain(const char *line, size_t len, const char **domain, size_t *dlen)
+{
+    cookie_attr(line, len, "domain", domain, dlen);
+    if (*dlen && **domain == '.') {
+        (*domain)++;
+        (*dlen)--;
+    }
+    if (!*dlen)
+        cookie_attr(line, len, "@hostonly", domain, dlen);
+}
+
+/* Cookies are the same if their name, domain and path match. http.c adds
+ * the host to cookies without a domain, so a missing domain or path matches
+ * any. */
+static int same_cookie(const char *a, size_t alen, const char *b, size_t blen)
+{
+    const char *an, *av, *bn, *bv;
+    size_t anl, avl, bnl, bvl;
+
+    cookie_name_value(a, alen, &an, &anl, &av, &avl);
+    cookie_name_value(b, blen, &bn, &bnl, &bv, &bvl);
+    if (!span_eq(an, anl, bn, bnl, 0))
+        return 0;
+    cookie_domain(a, alen, &av, &avl);
+    cookie_domain(b, blen, &bv, &bvl);
+    if (avl && bvl && !span_eq(av, avl, bv, bvl, 1))
+        return 0;
+    cookie_attr(a, alen, "path", &av, &avl);
+    cookie_attr(b, blen, "path", &bv, &bvl);
+    return !avl || !bvl || span_eq(av, avl, bv, bvl, 0);
+}
+
+/* Whether the request was sent with this cookie and value already, so that it
+ * isn't an update by the response. */
+static int cookie_sent(const char *sent, const char *line, size_t len)
+{
+    const char *n, *v, *sn, *sv;
+    size_t nl, vl, snl, svl;
+
+    cookie_name_value(line, len, &n, &nl, &v, &vl);
+    while (sent && *sent) {
+        size_t sl = strcspn(sent, "\n");
+
+        cookie_name_value(sent, sl, &sn, &snl, &sv, &svl);
+        if (same_cookie(sent, sl, line, len) && span_eq(sv, svl, v, vl, 0))
+            return 1;
+        sent += sl + (sent[sl] == '\n');
+    }
+    return 0;
+}
+
+/* Parallel requests all start from the same cookie jar, but the response
+ * returns the cookies of the request with its updates applied. Apply only
+ * those updates to the current jar, so that the cookies set by the other
+ * requests in the meantime are kept. */
+static char *merge_cookies(const char *jar, const char *sent, const char *cookies)
+{
+    AVBPrint bp;
+    char *ret;
+
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    for (const char *j = jar; *j; ) {
+        size_t jl = strcspn(j, "\n");
+        int replaced = 0;
+
+        for (const char *u = cookies; jl && *u && !replaced; ) {
+            size_t ul = strcspn(u, "\n");
+            replaced = ul && !cookie_sent(sent, u, ul) && same_cookie(j, jl, u, ul);
+            u += ul + (u[ul] == '\n');
+        }
+        if (jl && !replaced) {
+            av_bprint_append_data(&bp, j, jl);
+            av_bprint_chars(&bp, '\n', 1);
+        }
+        j += jl + (j[jl] == '\n');
+    }
+    for (const char *u = cookies; *u; ) {
+        size_t ul = strcspn(u, "\n");
+
+        if (ul && !cookie_sent(sent, u, ul)) {
+            av_bprint_append_data(&bp, u, ul);
+            av_bprint_chars(&bp, '\n', 1);
+        }
+        u += ul + (u[ul] == '\n');
+    }
+    if (!av_bprint_is_complete(&bp)) {
+        av_bprint_finalize(&bp, NULL);
+        return NULL;
+    }
+    if (av_bprint_finalize(&bp, &ret) < 0)
+        return NULL;
+    return ret;
+}
