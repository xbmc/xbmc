rm -rf $HOME/android-tools/xbmc-tarballs
rm -rf $HOME/android-tools/xbmc-depends
rm -rf $HOME/build/kodi-build
. $HOME/source_me_use_java17.sh
echo JAVA_HOME = $JAVA_HOME
cd $HOME/build/kodi/tools/depends && \
 ./bootstrap && \
# ./configure --with-tarballs=$HOME/android-tools/xbmc-tarballs --host=aarch64-linux-android --with-sdk-path=$HOME/android-tools/android-sdk-linux --with-ndk-path=$HOME/android-tools/android-sdk-linux/ndk/21.4.7075529 --prefix=$HOME/android-tools/xbmc-depends --enable-debug=no && \
