 make -j$(getconf _NPROCESSORS_ONLN) && \
 cd $HOME/build/kodi && \
 make -j$(getconf _NPROCESSORS_ONLN) -C tools/depends/target/binary-addons ADDONS="audioencoder.flac" && \
 mkdir $HOME/build/kodi-build && \
 cd $HOME/build/kodi && \
